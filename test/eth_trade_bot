        eth_value = calculate_contract_value(validated_size)

        request = {
            "instId": SYMBOL,
            "tdMode": "isolated",
            "clOrdId": cl_ord_id,
            "side": side,
            "posSide": trading_direction,
            "ordType": "market",
            "sz": str(validated_size)
        }

        # 应用速率限制
        await check_rate_limit(1)

        # 发送下单请求（线程池）
        log_action("A1下单", "发送市价开仓请求", "debug", request)
